{
  "expo": {
    "name": "Pawductivity",
    "slug": "pawductivity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/logo-paw.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.pawductivity.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/logo-paw.png",
        "backgroundColor": "#0C4C60"
      },
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawductivity.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "27ed1726-88ab-4e84-a688-6db47d483424"
      },
      "googleWebClientId": "431119941310-49pgvbf66j4at1sgoqqf05ukmf1e2rmu.apps.googleusercontent.com"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/logo-paw.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C4C60"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.margelo.nitro.** { *; }\n"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pawductivity uses your photos only to set your profile picture."
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
